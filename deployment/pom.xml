<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>eu.dariolucia.jsatdecode</groupId>
    <artifactId>jsatdecode-deployment</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>JSatDecode and JSatInspector deployments</name>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <skipTests>false</skipTests>
        <!-- Local release archives are not published as a Maven artifact. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <jsatdecode.archive>-</jsatdecode.archive>
        <jsatinspector.archive>-</jsatinspector.archive>
    </properties>
    <dependencies>
        <dependency>
            <groupId>eu.dariolucia.jsatdecode</groupId><artifactId>jsatdecode-api</artifactId><version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.dariolucia.jsatdecode</groupId><artifactId>jsatdecode-core</artifactId><version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.dariolucia.jsatdecode</groupId><artifactId>jsatdecode-source-file</artifactId><version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>eu.dariolucia.jsatdecode</groupId><artifactId>jsatdecode-source-fmcomms2</artifactId><version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-assembly-plugin</artifactId><version>3.7.1</version>
                <configuration><appendAssemblyId>false</appendAssemblyId><attach>false</attach></configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.1</version>
                <executions><execution>
                    <id>compile-deployment-checks</id><phase>pre-integration-test</phase><goals><goal>testCompile</goal></goals>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.5.1</version>
                <executions><execution>
                    <id>deployment-checks</id><phase>verify</phase><goals><goal>java</goal></goals>
                    <configuration>
                        <mainClass>eu.dariolucia.jsatdecode.deployment.DeploymentTest</mainClass>
                        <classpathScope>test</classpathScope><skip>${skipTests}</skip>
                        <arguments><argument>${jsatdecode.archive}</argument><argument>${jsatinspector.archive}</argument></arguments>
                    </configuration>
                </execution></executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- Both profiles are active for an ordinary build. Explicitly selecting
             either profile builds only that application's dependency closure. -->
        <profile>
            <id>jsatdecode</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <properties><jsatdecode.archive>${project.build.directory}/jsatdecode-${project.version}.zip</jsatdecode.archive></properties>
            <dependencies>
                <dependency>
                    <groupId>eu.dariolucia.jsatdecode</groupId><artifactId>jsatdecode-distribution-zmq</artifactId><version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>eu.dariolucia.jsatdecode</groupId><artifactId>jsatdecode-distribution-jtdp</artifactId><version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>eu.dariolucia.jsatdecode</groupId><artifactId>decoder-base</artifactId><version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>eu.dariolucia.jsatdecode</groupId><artifactId>decoder-elektrol-ggak</artifactId><version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>eu.dariolucia.jsatdecode</groupId><artifactId>decoder-hinode</artifactId><version>${project.version}</version>
                </dependency>
            </dependencies>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-assembly-plugin</artifactId>
                <executions><execution>
                    <id>jsatdecode-deployment</id><phase>package</phase><goals><goal>single</goal></goals>
                    <configuration>
                        <finalName>jsatdecode-${project.version}</finalName>
                        <descriptors><descriptor>src/assembly/jsatdecode.xml</descriptor></descriptors>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>jsatinspector</id>
            <activation><activeByDefault>true</activeByDefault></activation>
            <properties><jsatinspector.archive>${project.build.directory}/jsatinspector-${project.version}.zip</jsatinspector.archive></properties>
            <dependencies><dependency>
                <groupId>eu.dariolucia.jsatdecode</groupId><artifactId>jsatdecode-inspector</artifactId><version>${project.version}</version>
            </dependency></dependencies>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-assembly-plugin</artifactId>
                <executions><execution>
                    <id>jsatinspector-deployment</id><phase>package</phase><goals><goal>single</goal></goals>
                    <configuration>
                        <finalName>jsatinspector-${project.version}</finalName>
                        <descriptors><descriptor>src/assembly/jsatinspector.xml</descriptor></descriptors>
                    </configuration>
                </execution></executions>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
