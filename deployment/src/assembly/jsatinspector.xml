<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 https://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>jsatinspector</id>
    <formats><format>zip</format><format>tar.gz</format></formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>jsatinspector-${project.version}</baseDirectory>
    <dependencySets><dependencySet>
        <outputDirectory>lib</outputDirectory><scope>runtime</scope><useProjectArtifact>false</useProjectArtifact>
        <useTransitiveFiltering>true</useTransitiveFiltering>
        <includes>
            <include>eu.dariolucia.jsatdecode:jsatdecode-api</include>
            <include>eu.dariolucia.jsatdecode:jsatdecode-core</include>
            <include>eu.dariolucia.jsatdecode:jsatdecode-inspector</include>
            <include>eu.dariolucia.jsatdecode:jsatdecode-source-file</include>
            <include>eu.dariolucia.jsatdecode:jsatdecode-source-fmcomms2</include>
        </includes>
    </dependencySet></dependencySets>
    <fileSets>
        <fileSet>
            <directory>../inspector/src/main/bin</directory><outputDirectory>bin</outputDirectory>
            <includes><include>*.sh</include></includes><fileMode>0755</fileMode><lineEnding>unix</lineEnding>
        </fileSet>
        <fileSet>
            <directory>../inspector/src/main/bin</directory><outputDirectory>bin</outputDirectory>
            <includes><include>*.bat</include></includes><fileMode>0644</fileMode><lineEnding>dos</lineEnding>
        </fileSet>
        <fileSet>
            <directory>.</directory><outputDirectory>/</outputDirectory><includes><include>README.md</include></includes>
        </fileSet>
        <fileSet><directory>..</directory><outputDirectory>/</outputDirectory><includes><include>LICENSE</include></includes></fileSet>
        <fileSet>
            <directory>../inspector/src/main/resources</directory><outputDirectory>icons</outputDirectory>
            <includes><include>icon-jsatinspector.png</include></includes>
        </fileSet>
        <fileSet>
            <directory>..</directory><outputDirectory>docs</outputDirectory>
            <includes>
                <include>README.md</include><include>deployment/README.md</include>
                <include>api/README.md</include><include>source_file/README.md</include><include>source_fmcomms2/README.md</include>
                <include>distribution_zmq/README.md</include><include>distribution_jtdp/README.md</include>
                <include>core/README.md</include><include>core/docs/**</include>
                <include>inspector/README.md</include><include>inspector/docs/**</include>
                <include>decoder_*/README.md</include><include>decoder_*/docs/**</include><include>decoder_*/examples/**</include>
                <include>regression/*.md</include>
            </includes>
        </fileSet>
    </fileSets>
</assembly>
