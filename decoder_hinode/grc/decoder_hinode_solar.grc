- name: frame_collector
  id: epy_block
  parameters:
    _source_code: "from collections import deque\nfrom pathlib import Path\nimport\
      \ pmt\nfrom gnuradio import gr\n\nclass blk(gr.basic_block):\n    \"\"\"\n \
      \   Low-rate four-branch gr-satellites PDU collector.\n\n    It does not process\
      \ streaming samples. Exact duplicate frames emitted by\n    parallel ambiguity\
      \ branches are suppressed using the last three accepted\n    payloads, matching\
      \ the proven SatDecode receiver strategy.\n    \"\"\"\n    def __init__(self,\
      \ outfile='hinode_v10_frames.tf'):\n        gr.basic_block.__init__(\n     \
      \       self, name='Hinode four-branch PDU collector',\n            in_sig=None,\
      \ out_sig=None)\n\n        self.outfile = str(outfile)\n        self.recent\
      \ = deque(maxlen=3)\n        self.count = 0\n        self.duplicates = 0\n \
      \       self.branch_counts = {\n            'p0_normal': 0,\n            'p0_inverted':\
      \ 0,\n            'p1_normal': 0,\n            'p1_inverted': 0,\n        }\n\
      \n        p = Path(self.outfile).expanduser()\n        if p.parent != Path('.'):\n\
      \            p.parent.mkdir(parents=True, exist_ok=True)\n        self.f = p.open('wb')\n\
      \n        for name in self.branch_counts:\n            port = pmt.intern(name)\n\
      \            self.message_port_register_in(port)\n\n        self.set_msg_handler(pmt.intern('p0_normal'),\
      \ self._p0_normal)\n        self.set_msg_handler(pmt.intern('p0_inverted'),\
      \ self._p0_inverted)\n        self.set_msg_handler(pmt.intern('p1_normal'),\
      \ self._p1_normal)\n        self.set_msg_handler(pmt.intern('p1_inverted'),\
      \ self._p1_inverted)\n\n    @staticmethod\n    def _payload(msg):\n        obj\
      \ = pmt.cdr(msg) if pmt.is_pair(msg) else msg\n        return bytes(pmt.u8vector_elements(obj))\n\
      \n    def _p0_normal(self, msg): self._handle('p0_normal', msg)\n    def _p0_inverted(self,\
      \ msg): self._handle('p0_inverted', msg)\n    def _p1_normal(self, msg): self._handle('p1_normal',\
      \ msg)\n    def _p1_inverted(self, msg): self._handle('p1_inverted', msg)\n\n\
      \    def _handle(self, branch, msg):\n        data = self._payload(msg)\n  \
      \      self.branch_counts[branch] += 1\n\n        if data in self.recent:\n\
      \            self.duplicates += 1\n            return\n\n        self.recent.append(data)\n\
      \        self.f.write(data)\n        self.count += 1\n\n        if self.count\
      \ <= 5 or (self.count % 25) == 0:\n            vcid = (data[1] & 0x3f) if len(data)\
      \ >= 2 else -1\n            print('[Hinode-v10] frame=%d branch=%s bytes=%d\
      \ VCID=%d' %\n                  (self.count, branch, len(data), vcid))\n\n \
      \   def stop(self):\n        try:\n            self.f.flush()\n            self.f.close()\n\
      \        except Exception:\n            pass\n        print('[Hinode-v10] accepted\
      \ frames=%d duplicates=%d branches=%s' %\n              (self.count, self.duplicates,\n\
      \               ' '.join('%s=%d' % (k,v) for k,v in self.branch_counts.items())))\n\
      \        print('[Hinode-v10] output=%s (892-byte post-RS transfer frames)' %\
      \ self.outfile)\n        return True\n"
    affinity: ''
    alias: ''
    comment: Low-rate PDU-only collector/deduplicator. No streaming DSP in Python.
    maxoutbuf: '0'
    minoutbuf: '0'
    outfile: frame_file
  states:
    _io_cache: ('Hinode four-branch PDU collector', 'blk', [('outfile', "'hinode_v10_frames.tf'")],
      [('p1_inverted', 'message', 1), ('p0_normal', 'message', 1), ('p1_normal', 'message',
      1), ('p0_inverted', 'message', 1)], [], '\nLow-rate four-branch gr-satellites
      PDU collector.\n\nIt does not process streaming samples. Exact duplicate frames
      emitted by\nparallel ambiguity branches are suppressed using the last three
      accepted\npayloads, matching the proven SatDecode receiver strategy.\n', ['outfile'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [3280, 430]
    rotation: 0
    state: enabled
