- name: acq_controller
  id: epy_block
  parameters:
    _source_code: "import inspect\nimport threading\nimport time\nfrom gnuradio import\
      \ gr\n\nclass blk(gr.basic_block):\n    \"\"\"\n    Out-of-band acquisition\
      \ controller.\n\n    No stream ports: this block never processes samples. The\
      \ three block-name\n    parameters are ordinary GRC string variables. At runtime\
      \ the controller\n    resolves the corresponding native blocks from the generated\
      \ top_block.\n    \"\"\"\n\n    def __init__(self,\n                 pll_block_name='native_pll',\n\
      \                 costas_block_name='native_costas',\n                 mm_block_name='native_mm',\n\
      \                 sample_rate=500000.0,\n                 symbol_rate=65600.0,\n\
      \                 acq_seconds=12.0,\n                 pll_steady=0.01,\n   \
      \              costas_steady=0.005,\n                 mm_mu_steady=0.01,\n \
      \                mm_omega_steady=0.000025):\n        gr.basic_block.__init__(\n\
      \            self,\n            name='Hinode acquisition controller',\n    \
      \        in_sig=None,\n            out_sig=None)\n\n        self.pll_block_name\
      \ = str(pll_block_name)\n        self.costas_block_name = str(costas_block_name)\n\
      \        self.mm_block_name = str(mm_block_name)\n\n        self.sample_limit\
      \ = int(round(float(sample_rate) * float(acq_seconds)))\n        self.symbol_limit\
      \ = int(round(float(symbol_rate) * float(acq_seconds)))\n\n        self.pll_steady\
      \ = float(pll_steady)\n        self.costas_steady = float(costas_steady)\n \
      \       self.mm_mu_steady = float(mm_mu_steady)\n        self.mm_omega_steady\
      \ = float(mm_omega_steady)\n\n        # GRC instantiates the block once for\
      \ introspection. In the actual\n        # generated flowgraph, the caller is\
      \ top_block.__init__, whose local\n        # 'self' is the generated flowgraph\
      \ instance.\n        frame = inspect.currentframe()\n        caller = frame.f_back\
      \ if frame is not None else None\n        parent = caller.f_locals.get('self')\
      \ if caller is not None else None\n\n        if parent is not None:\n      \
      \      self._parent = parent\n            threading.Thread(\n              \
      \  target=self._run,\n                daemon=True,\n                name='hinode-acquisition-control').start()\n\
      \n    def _resolve_blocks(self):\n        # The controller can be constructed\
      \ before all later blocks exist.\n        # Wait briefly for the generated top_block\
      \ constructor to finish.\n        for _ in range(5000):\n            try:\n\
      \                pll = getattr(self._parent, self.pll_block_name)\n        \
      \        costas = getattr(self._parent, self.costas_block_name)\n          \
      \      mm = getattr(self._parent, self.mm_block_name)\n                return\
      \ pll, costas, mm\n            except AttributeError:\n                time.sleep(0.001)\n\
      \        return None, None, None\n\n    def _run(self):\n        pll, costas,\
      \ mm = self._resolve_blocks()\n        if pll is None or costas is None or mm\
      \ is None:\n            print('[Hinode-v10.2] acquisition controller: native\
      \ block lookup failed')\n            return\n\n        carrier_done = False\n\
      \        clock_done = False\n\n        while not (carrier_done and clock_done):\n\
      \            try:\n                if (not carrier_done\n                  \
      \      and int(costas.nitems_written(0)) >= self.sample_limit):\n          \
      \          pll.set_loop_bandwidth(self.pll_steady)\n                    costas.set_loop_bandwidth(self.costas_steady)\n\
      \                    carrier_done = True\n                    print('[Hinode-v10.2]\
      \ PLL/Costas -> steady state at ~12 s signal time')\n\n                if (not\
      \ clock_done\n                        and int(mm.nitems_written(0)) >= self.symbol_limit):\n\
      \                    mm.set_gain_mu(self.mm_mu_steady)\n                   \
      \ mm.set_gain_omega(self.mm_omega_steady)\n                    clock_done =\
      \ True\n                    print('[Hinode-v10.2] M&M -> steady state at ~12\
      \ s signal time')\n\n            except Exception as exc:\n                print('[Hinode-v10.2]\
      \ acquisition controller warning:', repr(exc))\n                return\n\n \
      \           time.sleep(0.001)\n"
    acq_seconds: acq_seconds
    affinity: ''
    alias: ''
    comment: Out-of-band controller. Uses three ordinary GRC block-name variables;
      no stream samples pass through Python.
    costas_block_name: costas_block_name
    costas_steady: costas_bw_steady
    maxoutbuf: '0'
    minoutbuf: '0'
    mm_block_name: mm_block_name
    mm_mu_steady: mm_gain_mu_steady
    mm_omega_steady: mm_gain_omega_steady
    pll_block_name: pll_block_name
    pll_steady: pll_bw_steady
    sample_rate: bb_rate
    symbol_rate: symbol_rate
  states:
    _io_cache: '(''Hinode acquisition controller'', ''blk'', [(''pll_block_name'',
      "''native_pll''"), (''costas_block_name'', "''native_costas''"), (''mm_block_name'',
      "''native_mm''"), (''sample_rate'', ''500000.0''), (''symbol_rate'', ''65600.0''),
      (''acq_seconds'', ''12.0''), (''pll_steady'', ''0.01''), (''costas_steady'',
      ''0.005''), (''mm_mu_steady'', ''0.01''), (''mm_omega_steady'', ''2.5e-05'')],
      [], [], ''\nOut-of-band acquisition controller.\n\nNo stream ports: this block
      never processes samples. The three block-name\nparameters are ordinary GRC string
      variables. At runtime the controller\nresolves the corresponding native blocks
      from the generated top_block.\n'', [''costas_block_name'', ''costas_steady'',
      ''mm_block_name'', ''mm_mu_steady'', ''mm_omega_steady'', ''pll_block_name'',
      ''pll_steady''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2060, 470]
    rotation: 0
    state: enabled
