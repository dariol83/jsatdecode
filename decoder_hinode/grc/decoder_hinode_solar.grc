options:
  parameters:
    author: OpenAI / Dario Lucia
    catch_exceptions: 'True'
    category: '[Satellite]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Validated v10.2 decoder with selectable WAV or Pluto SDR input. Pluto
      defaults to ip:192.168.2.1, manual gain 32 dB, 2 Msps / 2 MHz, native FIR decimation
      to 500 kS/s.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: hinode_solar_v10_3_native_grsat
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Hinode S-band v10.3 \u2014 WAV or Pluto native GNU Radio + gr-satellites"
    window_size: (1550,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

