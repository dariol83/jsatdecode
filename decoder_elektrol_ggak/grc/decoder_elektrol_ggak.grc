- name: epy_block_afc
  id: epy_block
  parameters:
    samp_rate: post_rate
    nfft: '65536'
    init_blocks: '2'
    avg_blocks: '8'
    search_hz: '30000.0'
    sub_hz: symbol_rate
    min_db: '12.0'
    hyst_hz: '40.0'
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    \"\"\"Blind carrier acquisition\
      \ + coarse AFC for residual-carrier PM / BPSK-subcarrier signals.\n\n    Squaring a PM signal with a residual carrier\
      \ produces a data-independent spectral\n    line at exactly 2*f_carrier (plus weaker lines at 2*f_carrier +/- 2*subcarrier).\n\
      \    The block finds that line on a long-term averaged |FFT(x^2)|^2, mixes the carrier\n    to 0 Hz and hands the fine\
      \ tracking to the narrow carrier PLL.\n\n    Output is the input delayed by init_blocks*nfft samples (zeros until the\
      \ first\n    estimate exists), so no signal is lost while the carrier is being found.\n    The mixing frequency is only\
      \ changed when the new estimate differs from the\n    current one by more than hyst_hz (the PLL follows slow drift by\
      \ itself).\n    \"\"\"\n\n    def __init__(self, samp_rate=250000.0, nfft=65536, init_blocks=2, avg_blocks=8,\n    \
      \             search_hz=30000.0, sub_hz=5000.0, min_db=12.0, hyst_hz=40.0):\n        gr.sync_block.__init__(self, name='PM\
      \ carrier AFC',\n                               in_sig=[np.complex64], out_sig=[np.complex64])\n        self.fs = float(samp_rate)\n\
      \        self.nfft = int(nfft)\n        self.init_blocks = int(init_blocks)\n        self.avg_blocks = int(avg_blocks)\n\
      \        self.search_hz = float(search_hz)\n        self.sub_hz = float(sub_hz)\n        self.min_db = float(min_db)\n\
      \        self.hyst_hz = float(hyst_hz)\n        self._win = np.hanning(self.nfft)\n        self._bins = np.fft.fftfreq(self.nfft,\
      \ 1.0 / self.fs)\n        self._mask = np.flatnonzero(np.abs(self._bins) <= 2.0 * self.search_hz)\n        self._hist\
      \ = []\n        self._pend = np.zeros(0, np.complex64)\n        self._delay = np.zeros(self.init_blocks * self.nfft,\
      \ np.complex64)\n        self._f = None          # current mixing frequency [Hz]\n        self._phase = 0.0\n      \
      \  self.last_db = 0.0\n        self.estimates = 0\n\n    def _estimate(self):\n        P = np.mean(self._hist, axis=0)\n\
      \        n = self.nfft\n        d = int(round(2.0 * self.sub_hz * n / self.fs))\n        S = P + 0.5 * (np.roll(P, d)\
      \ + np.roll(P, -d))   # line at 2fc and its +/-2*sub partners\n        k = self._mask[np.argmax(S[self._mask])]\n  \
      \      a, b, c = np.log(S[k - 1] + 1e-300), np.log(S[k] + 1e-300), np.log(S[(k + 1) % n] + 1e-300)\n        den = a\
      \ - 2.0 * b + c\n        dl = 0.5 * (a - c) / den if den != 0 else 0.0\n        f2c = self._bins[k] + dl * self.fs /\
      \ n\n        db = 10.0 * np.log10((P[k] + 1e-300) / (np.median(P) + 1e-300))\n        return 0.5 * f2c, db\n\n    def\
      \ _analyse(self, blk):\n        y = (blk.astype(np.complex128) ** 2) * self._win\n        self._hist.append(np.abs(np.fft.fft(y))\
      \ ** 2)\n        if len(self._hist) > self.avg_blocks:\n            self._hist.pop(0)\n        if len(self._hist) <\
      \ self.init_blocks:\n            return\n        f, db = self._estimate()\n        self.last_db = db\n        if db\
      \ >= self.min_db and (self._f is None or abs(f - self._f) > self.hyst_hz):\n            self._f = f\n            self.estimates\
      \ += 1\n            print('[AFC] carrier %.1f Hz (line %.1f dB above floor)' % (f, db))\n\n    def work(self, input_items,\
      \ output_items):\n        x = input_items[0]\n        n = len(x)\n        self._pend = np.concatenate([self._pend, x])\n\
      \        while len(self._pend) >= self.nfft:\n            self._analyse(self._pend[:self.nfft])\n            self._pend\
      \ = self._pend[self.nfft:]\n        self._delay = np.concatenate([self._delay, x])\n        src = self._delay[:n]\n\
      \        self._delay = self._delay[n:]\n        if self._f is None:\n            output_items[0][:n] = 0\n         \
      \   return n\n        inc = -2.0 * np.pi * self._f / self.fs\n        ph = self._phase + inc * np.arange(n, dtype=np.float64)\n\
      \        output_items[0][:n] = (src * np.exp(1j * ph)).astype(np.complex64)\n        self._phase = float((self._phase\
      \ + inc * n) % (2.0 * np.pi))\n        return n\n"
    affinity: ''
    alias: ''
    comment: 'Blind carrier acquisition: finds the data-independent line at 2*fc in |FFT(x^2)|^2, mixes the residual carrier
      to 0 Hz. Output is delayed 2*65536 samples (zeros until the first estimate). Re-centres only if the carrier moves >40
      Hz.'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache:
    - PM carrier AFC
    - blk
    - - - samp_rate
        - '250000.0'
      - - nfft
        - '65536'
      - - init_blocks
        - '2'
      - - avg_blocks
        - '8'
      - - search_hz
        - '30000.0'
      - - sub_hz
        - '5000.0'
      - - min_db
        - '12.0'
      - - hyst_hz
        - '40.0'
    - - - '0'
        - complex
        - 1
    - - - '0'
        - complex
        - 1
    - ''
    - []
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 430
    - 288
    rotation: 0
    state: enabled
- name: epy_block_norm
  id: epy_block
  parameters:
    samp_rate: timing_rate
    tau: '0.25'
    sub: '250'
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n    \"\"\"Level-independent\
      \ power normaliser (replaces analog.agc).\n\n    GNU Radio's agc adds rate*(ref-|y|) to the gain, so with small sample\
      \ amplitudes\n    (e.g. int16/32768 recordings, ~1e-4) its time constant is 1/(rate*|x|) -- tens of\n    seconds --\
      \ and the Costas/M&M loops see the wrong amplitude all that time.\n    This block scales the stream to unit mean power\
      \ with a fixed time constant,\n    whatever the input level.  Silence (exact zeros) is passed through unchanged.\n \
      \   \"\"\"\n\n    def __init__(self, samp_rate=50000.0, tau=0.25, sub=250):\n        gr.sync_block.__init__(self, name='Power\
      \ normaliser',\n                               in_sig=[np.complex64], out_sig=[np.complex64])\n        self.fs = float(samp_rate)\n\
      \        self.tau = float(tau)\n        self.sub = int(sub)\n        self.P = None\n\n    def work(self, input_items,\
      \ output_items):\n        x = input_items[0]\n        n = len(x)\n        out = output_items[0]\n        for i in range(0,\
      \ n, self.sub):\n            seg = x[i:i + self.sub]\n            p = float(np.mean(seg.real.astype(np.float64) ** 2\
      \ + seg.imag.astype(np.float64) ** 2))\n            if p <= 1e-30:\n                out[i:i + len(seg)] = 0\n      \
      \          continue\n            if self.P is None:\n                self.P = p\n            else:\n               \
      \ a = 1.0 - np.exp(-len(seg) / (self.tau * self.fs))\n                self.P += a * (p - self.P)\n            out[i:i\
      \ + len(seg)] = seg / np.sqrt(self.P)\n        return n\n"
    affinity: ''
    alias: ''
    comment: Level-independent power normaliser (replaces analog AGC). Costas/M&M error detectors expect ~unit symbol amplitude.
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache:
    - Power normaliser
    - blk
    - - - samp_rate
        - '50000.0'
      - - tau
        - '0.25'
      - - sub
        - '250'
    - - - '0'
        - complex
        - 1
    - - - '0'
        - complex
        - 1
    - ''
    - []
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1344
    - 400
    rotation: 0
    state: enabled
