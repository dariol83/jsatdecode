options:
  parameters:
    author: OpenAI / generated for Dario Lucia
    catch_exceptions: 'True'
    category: Satellite
    cmake_opt: ''
    comment: 'Elektro-L 5 GGAK diagnostic receiver v1.5. v1.5 changes vs v1.4: (1) blind carrier acquisition/AFC from the
      2*fc line of x^2 (data independent) instead of relying on the carrier PLL to find the residual carrier; (2) carrier
      PLL narrowed 0.02 -> 0.002 rad/sample, +/-200 Hz; (3) analog AGC replaced by a level-independent power normaliser placed
      before Costas/M&M; (4) M&M gain_mu 0.01 -> 0.02. File source (cs16) added; Pluto source kept but disabled.'
    copyright: ''
    description: Elektro-L 5 GGAK 1693 MHz, 5 ksym/s PM/BPSK, blind-AFC PM demod, CCSDS ASM 1ACFFC1D, 1792-bit CADU
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: elektro_l5_ggak
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Elektro-L 5 GGAK Decoder v1.5
    window_size: (1280,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
