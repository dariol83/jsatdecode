- name: epy_block_pm
  id: epy_block
  parameters:
    sample_rate: timing_rate
    symbol_rate: symbol_rate
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n    \"\"\"SatDump PMToBPSK\
      \ equivalent.\n\n    For each PLL output sample, discard I and keep only j*Q, then rotate\n    continuously\
      \ by -symbol_rate. This mirrors SatDump's PMToBPSK block.\n    Input/output are complex64.\n    \"\"\"\n \
      \   def __init__(self, sample_rate=50000, symbol_rate=5000):\n        gr.sync_block.__init__(self, name='PMToBPSK\
      \ (SatDump equivalent)',\n                              in_sig=[np.complex64], out_sig=[np.complex64])\n \
      \       self.sample_rate = float(sample_rate)\n        self.symbol_rate = float(symbol_rate)\n        self.phase\
      \ = 0.0\n        self.phase_inc = -2.0*np.pi*self.symbol_rate/self.sample_rate\n\n    def work(self, input_items,\
      \ output_items):\n        x = input_items[0]\n        n = len(x)\n        if n == 0:\n            return 0\n\
      \        idx = np.arange(n, dtype=np.float64)\n        ph = self.phase + self.phase_inc*idx\n        rot =\
      \ np.exp(1j*ph)\n        y = (1j*x.imag.astype(np.float64))*rot\n        output_items[0][:n] = y.astype(np.complex64)\n\
      \        self.phase = float((self.phase + self.phase_inc*n + np.pi) % (2.0*np.pi) - np.pi)\n        return\
      \ n\n"
    affinity: ''
    alias: ''
    comment: 'Exact functional equivalent of current SatDump PMToBPSK: x -> j*imag(x), then NCO shift by -symbol_rate.'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache:
    - PMToBPSK (SatDump equivalent)
    - blk
    - - - sample_rate
        - '50000'
      - - symbol_rate
        - '5000'
    - - - '0'
        - complex
        - 1
    - - - '0'
        - complex
        - 1
    - ''
    - []
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1176
    - 288
    rotation: 0
    state: enabled
