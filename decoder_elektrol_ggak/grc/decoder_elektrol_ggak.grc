- name: epy_block_0
  id: epy_block
  parameters:
    frame_bits: '1792'
    search_errors: '2'
    locked_errors: '4'
    output_file: '"ggak_frames.bin"'
    _source_code: "import numpy as np\nimport time\nfrom gnuradio import gr\nimport pmt\n\nASM = 0x1ACFFC1D\nASM_BITS\
      \ = np.array([(ASM >> (31-i)) & 1 for i in range(32)], dtype=np.uint8)\n\nclass blk(gr.sync_block):\n    \"\
      \"\"Elektro-L 5 GGAK CCSDS ASM deframer.\n\n    Input: one recovered complex BPSK symbol per item (slice on\
      \ real part).\n    Output 'frames': 220-byte GGAK frame, with 32-bit ASM removed\n    from the 224-byte /\
      \ 1792-bit CADU. Both normal and inverted polarity\n    are accepted. Only frames passing the empirical additive\
      \ checksum are\n    published and recorded; the checksum bytes are retained.\n    \"\"\"\n    def __init__(self,\
      \ frame_bits=1792, search_errors=2, locked_errors=4, output_file='ggak_frames.bin'):\n        gr.sync_block.__init__(self,\
      \ name='GGAK ASM deframer', in_sig=[np.complex64], out_sig=None)\n        self.message_port_register_out(pmt.intern('frames'))\n\
      \        self.frame_bits = int(frame_bits)\n        self.search_errors = int(search_errors)\n        self.locked_errors\
      \ = int(locked_errors)\n        self._window = []\n        self._collect = None\n        self._invert = False\n\
      \        self._locked = False\n        self._asm_errors = 0\n        self.frames = 0\n        self.rejected_frames\
      \ = 0\n        if self.frame_bits != 1792:\n            raise ValueError(\"GGAK checksum requires 1792-bit\
      \ CADUs (220-byte frames)\")\n        self.output_file = str(output_file)\n        self._fh = open(self.output_file,\
      \ 'wb') if self.output_file else None\n        if self._fh is not None:\n            print('[GGAK] recording\
      \ frames to %s' % self.output_file)\n\n    def _publish(self, bits):\n        packed = np.packbits(np.asarray(bits,\
      \ dtype=np.uint8), bitorder='big').tobytes()\n        tm = packed[4:]\n        # Check canonical frame octets\
      \ after polarity normalization and ASM removal.\n        expected = (sum(tm[:218]) + 0x0202) & 0xffff\n  \
      \      received = (tm[218] << 8) | tm[219]\n        if expected != received:\n            self.rejected_frames\
      \ += 1\n            print('[GGAK] checksum reject: expected=%04X received=%04X, valid=%d rejected=%d' %\n\
      \                  (expected, received, self.frames, self.rejected_frames))\n            return\n        meta\
      \ = pmt.make_dict()\n        meta = pmt.dict_add(meta, pmt.intern('checksum_valid'), pmt.PMT_T)\n        meta\
      \ = pmt.dict_add(meta, pmt.intern('checksum'), pmt.from_long(received))\n        meta = pmt.dict_add(meta,\
      \ pmt.intern('rx_time_ns'), pmt.from_long(time.time_ns()))\n        meta = pmt.dict_add(meta, pmt.intern('frame_type'),\
      \ pmt.intern('GGAK'))\n        meta = pmt.dict_add(meta, pmt.intern('asm_errors'), pmt.from_long(self._asm_errors))\n\
      \        meta = pmt.dict_add(meta, pmt.intern('cadu_length'), pmt.from_long(len(packed)))\n        self.message_port_pub(pmt.intern('frames'),\
      \ pmt.cons(meta, pmt.init_u8vector(len(tm), list(tm))))\n        if self._fh is not None:\n            self._fh.write(tm)\n\
      \            self._fh.flush()\n        self.frames += 1\n        print('[GGAK] frame %d: %d bytes GGAK frame,\
      \ checksum=OK, ASM errors=%d, header=%s, rejected=%d' %\n              (self.frames, len(tm), self._asm_errors,\
      \ tm[:8].hex(), self.rejected_frames))\n\n    def work(self, input_items, output_items):\n        for sample\
      \ in input_items[0]:\n            bit = 1 if sample.real >= 0 else 0\n            if self._collect is not\
      \ None:\n                self._collect.append(bit ^ int(self._invert))\n                if len(self._collect)\
      \ >= self.frame_bits:\n                    bits = self._collect\n                    self._collect = None\n\
      \                    self._publish(bits)\n                    self._locked = True\n                continue\n\
      \            self._window.append(bit)\n            if len(self._window) > 32:\n                self._window.pop(0)\n\
      \            if len(self._window) == 32:\n                w = np.asarray(self._window, dtype=np.uint8)\n \
      \               e = int(np.count_nonzero(w != ASM_BITS))\n                ei = int(np.count_nonzero((1-w)\
      \ != ASM_BITS))\n                threshold = self.locked_errors if self._locked else self.search_errors\n\
      \                if min(e, ei) <= threshold:\n                    self._invert = ei < e\n                \
      \    self._asm_errors = min(e, ei)\n                    self._collect = ASM_BITS.tolist()\n              \
      \      self._window = []\n        return len(input_items[0])\n\n    def stop(self):\n        if self._fh is\
      \ not None:\n            self._fh.flush()\n            self._fh.close()\n            self._fh = None\n   \
      \     return True\n"
    affinity: ''
    alias: ''
    comment: "Emits and records only 220-byte GGAK frames passing additive checksum: (sum(frame[:218])+0x0202)&0xffff,\
      \ big-endian bytes 218\u2013219."
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache:
    - GGAK ASM deframer
    - blk
    - - - frame_bits
        - '1792'
      - - search_errors
        - '2'
      - - locked_errors
        - '4'
      - - output_file
        - '"ggak_frames.bin"'
    - - - '0'
        - complex
        - 1
    - - - frames
        - message
        - 1
    - ''
    - []
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1848
    - 520
    rotation: 0
    state: enabled
