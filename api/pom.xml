<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>eu.dariolucia.jsatdecode</groupId>
    <artifactId>jsatdecode-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>JSatDecode API</name>
    <description>Public contracts and reusable dependency-free utilities</description>
    <url>https://www.github.com/dariol83/jsatdecode</url>
    <developers>
        <developer>
            <name>Dario Lucia</name>
            <email>dario.lucia@gmail.com</email>
            <url>https://www.dariolucia.eu</url>
        </developer>
    </developers>
    <licenses>
        <license>
            <name>GNU GENERAL PUBLIC LICENSE, Version 2.0, with Classpath Exception</name>
            <url>https://github.com/dariol83/jsatdecode/blob/master/LICENSE</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <scm>
        <url>https://github.com/dariol83/jsatdecode</url>
        <connection>scm:git:https://github.com/dariol83/jsatdecode.git</connection>
        <developerConnection>scm:git:git@github.com:dariol83/jsatdecode.git</developerConnection>
    </scm>
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <skipTests>false</skipTests>
    </properties>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>observability-tests</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>eu.dariolucia.jsatdecode.ObservabilityTest</mainClass>
                            <classpathScope>test</classpathScope><skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>spectrum-tests</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>eu.dariolucia.jsatdecode.SpectrumTest</mainClass>
                            <classpathScope>test</classpathScope><skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>iq-buffer-pool-tests</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>eu.dariolucia.jsatdecode.IqBufferPoolTest</mainClass>
                            <classpathScope>test</classpathScope><skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-source-plugin</artifactId><version>3.4.0</version>
                        <executions><execution><id>attach-sources</id><phase>package</phase><goals><goal>jar-no-fork</goal></goals></execution></executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-javadoc-plugin</artifactId><version>3.12.0</version>
                        <executions><execution><id>attach-javadocs</id><phase>package</phase><goals><goal>jar</goal></goals></execution></executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-gpg-plugin</artifactId><version>3.2.8</version>
                        <executions><execution><id>sign-artifacts</id><phase>verify</phase><goals><goal>sign</goal></goals></execution></executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId><artifactId>central-publishing-maven-plugin</artifactId><version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration><publishingServerId>central</publishingServerId></configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
