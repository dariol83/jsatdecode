<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>eu.dariolucia.jsatdecode</groupId>
    <artifactId>jsatdecode-core</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>JSatDecode Core</name>
    <description>Satellite telemetry framework with isolated SatDecode ZMQ distribution</description>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <skipTests>false</skipTests>
    </properties>
    <dependencies>
        <!-- Implementation-only binding: no org.zeromq types in the stable API. -->
        <dependency>
            <groupId>org.zeromq</groupId><artifactId>jeromq</artifactId><version>0.6.0</version>
        </dependency>
        <!-- The unchanged Java reference decoder is compiled only for compatibility tests. -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-cbor</artifactId>
            <version>2.22.2</version><scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>jsatdecoder</finalName>
        <testResources>
            <testResource><directory>src/test/resources</directory></testResource>
            <testResource><directory>../protocol-test-vectors</directory><targetPath>protocol-test-vectors</targetPath></testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.7.0</version>
                <executions><execution><id>plain-jdk-dependencies</id><phase>process-test-resources</phase>
                    <goals><goal>copy-dependencies</goal></goals>
                    <configuration><includeScope>test</includeScope><outputDirectory>${project.build.directory}/test-dependencies</outputDirectory></configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.0</version>
                <executions><execution><id>reference-client-test-source</id><phase>generate-test-sources</phase>
                    <goals><goal>add-test-source</goal></goals>
                    <configuration><sources><source>../reference-clients/java/src/main/java</source></sources></configuration>
                </execution></executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <forceCreation>true</forceCreation>
                    <archive>
                        <manifest><mainClass>eu.dariolucia.jsatdecode.MainLauncher</mainClass></manifest>
                        <manifestEntries>
                            <Automatic-Module-Name>eu.dariolucia.jsatdecode.core</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
                <executions>
                    <execution>
                        <id>modular-core</id><phase>package</phase><goals><goal>jar</goal></goals>
                        <configuration><classifier>modular</classifier></configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <id>inspector-settings-tests</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration><mainClass>eu.dariolucia.jsatdecode.inspector.InspectorSettingsTest</mainClass><classpathScope>test</classpathScope><skip>${skipTests}</skip></configuration>
                    </execution>
                    <execution>
                        <id>inspector-receiver-tests</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration><mainClass>eu.dariolucia.jsatdecode.inspector.InspectorReceiverTest</mainClass><classpathScope>test</classpathScope><skip>${skipTests}</skip></configuration>
                    </execution>
                    <execution>
                        <id>inspector-recording-tests</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration><mainClass>eu.dariolucia.jsatdecode.inspector.IqRecorderTest</mainClass><classpathScope>test</classpathScope><skip>${skipTests}</skip></configuration>
                    </execution>
                    <execution>
                        <id>inspector-drop-sample-tests</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration><mainClass>eu.dariolucia.jsatdecode.inspector.InspectorDropSampleTest</mainClass><classpathScope>test</classpathScope><skip>${skipTests}</skip></configuration>
                    </execution>
                    <execution>
                        <id>inspector-analysis-tests</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration><mainClass>eu.dariolucia.jsatdecode.inspector.InspectorAnalysisTest</mainClass><classpathScope>test</classpathScope><skip>${skipTests}</skip></configuration>
                    </execution>
                    <execution>
                        <id>fmcomms2-source-tests</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration><mainClass>eu.dariolucia.jsatdecode.source.fmcomms2.Fmcomms2SourceTest</mainClass><classpathScope>test</classpathScope><skip>${skipTests}</skip></configuration>
                    </execution>
                    <execution>
                        <id>phase-one-contract-tests</id>
                        <phase>test</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>eu.dariolucia.jsatdecode.CoreApiTest</mainClass>
                            <classpathScope>test</classpathScope>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>phase-two-observability-tests</id>
                        <phase>test</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>eu.dariolucia.jsatdecode.ObservabilityTest</mainClass>
                            <classpathScope>test</classpathScope>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>phase-three-spectrum-tests</id>
                        <phase>test</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>eu.dariolucia.jsatdecode.SpectrumTest</mainClass>
                            <classpathScope>test</classpathScope>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>phase-four-file-source-tests</id>
                        <phase>test</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>eu.dariolucia.jsatdecode.FileSourceTest</mainClass>
                            <classpathScope>test</classpathScope>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>phase-five-runtime-tests</id>
                        <phase>test</phase>
                        <goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>eu.dariolucia.jsatdecode.RuntimeTest</mainClass>
                            <classpathScope>test</classpathScope>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verbose-monitoring-tests</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>eu.dariolucia.jsatdecode.core.runtime.VerboseMonitoringLogTest</mainClass>
                            <classpathScope>test</classpathScope><skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>zmq-reference-client-tests</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>eu.dariolucia.jsatdecode.distribution.zmq.client.ZmqClientTest</mainClass>
                            <classpathScope>test</classpathScope><skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>phase-six-swing-tests</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>eu.dariolucia.jsatdecode.ui.swing.MonitoringUiTest</mainClass>
                            <classpathScope>test</classpathScope><skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>phase-seven-spectrum-ui-tests</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>eu.dariolucia.jsatdecode.ui.swing.SpectrumUiTest</mainClass>
                            <classpathScope>test</classpathScope><skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>phase-eight-constellation-tests</id><phase>test</phase><goals><goal>java</goal></goals>
                        <configuration>
                            <mainClass>eu.dariolucia.jsatdecode.ui.swing.ConstellationUiTest</mainClass>
                            <classpathScope>test</classpathScope><skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
